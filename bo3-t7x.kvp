Meta.DisplayName=Call of Duty: Black Ops III - T7x / EZZ
Meta.Description=Black Ops III Unranked Dedicated Server using the AlterWare T7x client
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Git-Schlauch
Meta.URL=https://alterware.dev/
Meta.DisplayImageSource=steam:311210
Meta.EndpointURIFormat=
Meta.ConfigManifest=bo3-t7xconfig.json
Meta.MetaConfigManifest=bo3-t7xmetaconfig.json
Meta.ConfigRoot=bo3-t7x.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RequiredOnLinux
Meta.ContainerPolicyReason=Black Ops III and T7x are Windows x86_64 applications and require Wine on Linux.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=5
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=b476b23c-b005-478d-b3bf-ff52bcf28514
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.DisplayName=Call of Duty: Black Ops III - T7x / EZZ
App.RootDir=./bo3-t7x/
App.BaseDirectory=./bo3-t7x/server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=UnrankedServer\t7x.exe
App.ExecutableLinux=/usr/bin/python3
App.WorkingDir=server/UnrankedServer
App.LinuxCommandLineArgs=-u amp_bo3.py
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} --backend {{ServerBackend}} --masters {{MasterPreset}} --port {{$ServerPort}} --config {{ServerConfig}} --mod="{{ModFolder}}"
App.UseLinuxIOREDIR=False
App.AppSettings={"ServerConfig":"amp_zombies.cfg","ModFolder":"","ZmDefaultRules":"gamedata/gamesettings/zm/gamesettings_default.cfg","ZmOnlineRules":"gamedata/configs/common/default_xboxlive.cfg","ZmClassicRules":"gamedata/gamesettings/zm/gamesettings_zclassic.cfg","ZmServerName":"BO3 Zombies Server","ZmDescription":"Zombies auf AMP","ZmMaxPlayers":"4","ZmMinPlayers":"1","ZmJoinPassword":"","ZmRconPassword":"","ZmPrivateSlots":"0","ZmTimeout":"30","ZmReconnect":"3","ZmPure":"0","ZmFloodProtect":"1","ZmGameLog":"logs/games_zm.log","ZmLobbyMode":"zm","ZmSkipLobby":"1","ZmLanOnly":"0","ZmThirdPerson":"0","ZmDeadChat":"0","ZmFreeGum":"1","ZmRotation":"gametype zclassic map zm_tomb","ServerBackend":"t7x","MasterPreset":"ezz"}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=+set {0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=25
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[bo3-t7xports.json]
App.AdminPortRef=ServerPort
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=18
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.UpdateSources=@IncludeJson[bo3-t7xupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate

Console.FilterMatchRegex=\e\[(\d+;)*(\d+)?[ABCDHJKfmsu]|\e\[?[?\>\=\da-z]+
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^$
Console.UserJoinRegex=^\[AMPBO3\] JOIN\|(?<userid>[^|]+)\|(?<username>.+)$
Console.UserLeaveRegex=^\[AMPBO3\] LEAVE\|(?<userid>[^|]+)\|(?<username>.+)$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}

Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
