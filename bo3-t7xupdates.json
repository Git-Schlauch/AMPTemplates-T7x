[
  {
    "UpdateStageName": "Download Black Ops III Dedicated Server",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "SteamCMD",
    "UpdateSourceData": "545990",
    "UpdateSourceTarget": "{{$FullBaseDir}}",
    "ForceDownloadPlatform": "Windows",
    "SkipOnFailure": false
  },
  {
    "UpdateStageName": "Create T7x Configuration Download Directory",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "CreateDirectory",
    "UpdateSourceArgs": "{{$FullRootDir}}t7x-config",
    "SkipOnFailure": false
  },
  {
    "UpdateStageName": "Download T7x Server Configuration",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "FetchURL",
    "UpdateSourceData": "https://github.com/Dss0/t7-server-config/archive/refs/heads/main.zip",
    "UpdateSourceTarget": "{{$FullRootDir}}t7x-config",
    "UnzipUpdateSource": true,
    "OverwriteExistingFiles": true,
    "DeleteAfterExtract": true,
    "SkipOnFailure": false,
    "UpdateSourceArgs": "t7x-config.zip"
  },
  {
    "UpdateStageName": "Install T7x Server Configuration",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "Executable",
    "UpdateSourceData": "/bin/bash",
    "UpdateSourceArgs": "-ec \"test -d \\\"{{$FullRootDir}}t7x-config/t7-server-config-main/t7x\\\"; test -d \\\"{{$FullRootDir}}t7x-config/t7-server-config-main/zone\\\"; mkdir -p \\\"{{$FullBaseDir}}UnrankedServer\\\"; cp -rn \\\"{{$FullRootDir}}t7x-config/t7-server-config-main/t7x\\\" \\\"{{$FullBaseDir}}UnrankedServer/\\\"; cp -rn \\\"{{$FullRootDir}}t7x-config/t7-server-config-main/zone\\\" \\\"{{$FullBaseDir}}UnrankedServer/\\\"\"",
    "SkipOnFailure": false
  },
  {
    "UpdateStageName": "Download AlterWare T7x",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "FetchURL",
    "UpdateSourceData": "https://master.bo3.eu/t7x/t7x.exe",
    "UpdateSourceTarget": "{{$FullBaseDir}}UnrankedServer/",
    "OverwriteExistingFiles": true,
    "SkipOnFailure": false,
    "UpdateSourceArgs": "t7x.exe",
    "UpdateSourceConditionSetting": "ServerBackend",
    "UpdateSourceConditionValue": "t7x"
  },
  {
    "UpdateStageName": "Initialise Wine Prefix",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "Executable",
    "UpdateSourceData": "/bin/bash",
    "UpdateSourceArgs": "-ec \"WINEPREFIX=\\\"{{$FullRootDir}}.wine\\\" WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init\"",
    "SkipOnFailure": false
  },
  {
    "UpdateStageName": "Download EZZ BOIII",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "FetchURL",
    "UpdateSourceData": "https://github.com/Ezz-lol/boiii-free/releases/latest/download/boiii.exe",
    "UpdateSourceTarget": "{{$FullBaseDir}}UnrankedServer/",
    "UpdateSourceArgs": "boiii.exe",
    "OverwriteExistingFiles": true,
    "SkipOnFailure": false,
    "UpdateSourceConditionSetting": "ServerBackend",
    "UpdateSourceConditionValue": "ezz"
  },
  {
    "UpdateStageName": "Install EZZ configuration support files",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "Executable",
    "UpdateSourceData": "/bin/bash",
    "UpdateSourceArgs": "-ec \"mkdir -p \\\"{{$FullBaseDir}}UnrankedServer/boiii\\\"; cp -rn \\\"{{$FullBaseDir}}UnrankedServer/t7x/.\\\" \\\"{{$FullBaseDir}}UnrankedServer/boiii/\\\"\"",
    "SkipOnFailure": false,
    "UpdateSourceConditionSetting": "ServerBackend",
    "UpdateSourceConditionValue": "ezz"
  },
  {
    "UpdateStageName": "Download AMP console and player adapter",
    "UpdateSourcePlatform": "Linux",
    "UpdateSource": "FetchURL",
    "UpdateSourceData": "https://raw.githubusercontent.com/Git-Schlauch/AMPTemplates-T7x/main/runtime/amp_bo3.py",
    "UpdateSourceTarget": "{{$FullBaseDir}}UnrankedServer/",
    "UpdateSourceArgs": "amp_bo3.py",
    "OverwriteExistingFiles": true,
    "SkipOnFailure": false
  }
]
